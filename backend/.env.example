# NEMT App V0.1 — server-side configuration only.
# Copy this file to backend/.env and replace placeholders locally.
# NEVER commit .env, never put these values in the web bundle.

# DEMO | TESTNET | LIVE (V0.1 has no LIVE order path)
NEMT_APP_MODE=DEMO
# binance (real public data, DEMO falls back to simulated data) | demo
NEMT_MARKET_SOURCE=binance

# Local API bind. Keep loopback-only unless a reverse proxy terminates TLS.
NEMT_API_HOST=127.0.0.1
NEMT_API_PORT=8000

# Required outside DEMO; use at least 32 random characters.
NEMT_SESSION_SECRET=replace-with-a-long-random-string
NEMT_COOKIE_SECURE=false

# Local DEMO only. Change these if the demo is reachable by other people.
NEMT_VIEWER_PASSWORD=nemt-viewer
NEMT_DEMO_PASSWORD=nemt-demo
NEMT_ADMIN_PASSWORD=nemt-admin

# DEMO passwords seeded into the local SQLite ledger.
NEMT_DATABASE_PATH=backend/.data/nemt_app.sqlite3
NEMT_ALLOWED_SYMBOLS=BTCUSDT
NEMT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hard risk limits (server-side, not configurable from the browser)
NEMT_MIN_ORDER_NOTIONAL=5
NEMT_MAX_ORDER_NOTIONAL=100
NEMT_MAX_DAILY_NOTIONAL=1000
NEMT_MAX_POSITION_NOTIONAL=1000
NEMT_MAX_OPEN_ORDERS=5
NEMT_MAX_ORDERS_PER_MINUTE=10
NEMT_MARKET_STALE_SECONDS=20
NEMT_ACCOUNT_STALE_SECONDS=60

# Empty by default. Use dedicated Spot Testnet keys only, with trade
# permission and withdrawals disabled. Never use production keys for CI.
NEMT_BINANCE_API_KEY=
NEMT_BINANCE_API_SECRET=
NEMT_ALLOW_TESTNET_TRADING=false

# TESTNET operator accounts (only seeded outside DEMO when passwords are set).
# Use a password manager; minimum 12 characters. Demo quick-login is disabled.
NEMT_TESTNET_TRADER_USERNAME=trader
NEMT_TESTNET_TRADER_PASSWORD=
NEMT_TESTNET_ADMIN_USERNAME=admin
NEMT_TESTNET_ADMIN_PASSWORD=

# Must stay false in V0.1. Real-money trading requires issue #15 approval.
NEMT_LIVE_TRADING_ENABLED=false
