# NEMT Sync 环境配置
# ====================
#
# 复制此文件为 .env 并填入实际值：
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# 获取 NOTION_TOKEN:
#   1. 打开 https://www.notion.so/my-integrations
#   2. 点击 "+ New integration"
#   3. 填写名称（如 "NEMT Sync"），选择工作区
#   4. 复制生成的 Token（格式：secret_xxx）
#   5. 在 Notion 中，将 Integration 添加到目标页面
#
# 数据库 ID 获取方法：
#   在 Notion 页面 URL 中提取：
#   https://notion.so/workspace/DB_ID?v=xxx
#   →  DB_ID 就是数据库 ID（32个字符，不含 ?v=xxx）
#

# ============================================================================
# Notion API 配置（必需）
# ============================================================================

# 你的 Notion Integration Token
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API 版本（一般不需要改）
NOTION_VERSION=2022-06-28

# ============================================================================
# Notion 父页面 ID（用于创建数据库）
# ============================================================================
#
# 默认值：愿景管理系统主页面
#   https://notion.so/NEMT-AI-34717dca0dd2806785a6d825f558f783
#
PARENT_PAGE_ID=34717dca0dd2806785a6d825f558f783

# ============================================================================
# Notion 数据库 ID（创建数据库后自动填入）
# ============================================================================
# 这些值会在运行 setup_databases.py 后自动写入 database_config.json
# 你也可以手动填入（32字符，不含连字符）

# 决策记录数据库
DECISIONS_DB_ID=

# 经验沉淀数据库
EXPERIENCES_DB_ID=

# 任务数据库
TASKS_DB_ID=

# ============================================================================
# 同步参数
# ============================================================================

# 调试模式（设为 true 可看到详细日志）
DEBUG=false
