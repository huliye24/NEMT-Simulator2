[Unit]
Description=NEMT Cloud MCP SSE Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/quant-sync-server/cloud_memory
ExecStart=/usr/bin/python3 /root/quant-sync-server/cloud_memory/mcp_server_enhanced.py
Restart=always
RestartSec=10
StandardOutput=append:/root/quant-sync-server/mcp_sse.log
StandardError=append:/root/quant-sync-server/mcp_sse.log
Environment="OBSIDIAN_VAULT_PATH=/root/obsidian_vault/NEMT_Notion"
Environment="MCP_SSE_PORT=8766"

[Install]
WantedBy=multi-user.target
