[Unit]
Description=NEMT Cloud Memory Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/quant-sync-server
ExecStart=/usr/bin/python3 /root/quant-sync-server/memory_server.py
Restart=always
RestartSec=10
StandardOutput=append:/root/quant-sync-server/memory_server.log
StandardError=append:/root/quant-sync-server/memory_server.log
Environment="OBSIDIAN_VAULT_PATH=/root/obsidian_vault/NEMT_Notion"
Environment="MEMORY_SERVER_PORT=8765"
Environment="MEMORY_SERVER_HOST=0.0.0.0"

[Install]
WantedBy=multi-user.target
