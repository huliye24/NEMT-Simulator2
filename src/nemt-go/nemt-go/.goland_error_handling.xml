<?xml version="1.0" encoding="UTF-8"?>
<!-- NEMT-Go 错误处理规范 -->
<error_handling_rules>
  <rule>
    <name>unchecked_error</name>
    <description>未检查的错误返回值</description>
    <severity>WARNING</severity>
    <pattern>\b[a-z]+\s*:=\s*.*\.\w+\(</pattern>
    <check>error_return_not_checked</check>
    <example>
      // 错误
      data, _ := json.Marshal(v)  // _ 应该被检查

      // 正确
      data, err := json.Marshal(v)
      if err != nil {
          return err
      }
    </example>
  </rule>

  <rule>
    <name>error_not_nil_check</name>
    <description>错误应该检查是否为 nil</description>
    <severity>ERROR</severity>
    <pattern>err != nil</pattern>
    <required>true</required>
  </rule>

  <rule>
    <name>error_variables</name>
    <description>错误变量应命名为 err</description>
    <severity>WARNING</severity>
    <pattern>\b(error|err)\b</pattern>
    <convention>err</convention>
  </rule>

  <rule>
    <name>error_wrapping</name>
    <description>错误应使用 fmt.Errorf 或 errors.Wrap 包装</description>
    <severity>WARNING</severity>
    <pattern>return\s+errors\.New\(</pattern>
    <suggestion>使用 fmt.Errorf("context: %w", err) 进行错误包装</suggestion>
  </rule>

  <rule>
    <name>no_error_silencing</name>
    <description>禁止静默错误</description>
    <severity>ERROR</severity>
    <patterns>
      <pattern>_, _ :=.*</pattern>
      <pattern>_ =.*error</pattern>
      <pattern>err == nil // 忽略错误</pattern>
    </patterns>
  </rule>
</error_handling_rules>