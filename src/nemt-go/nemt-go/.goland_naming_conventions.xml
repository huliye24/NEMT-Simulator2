<?xml version="1.0" encoding="UTF-8"?>
<!-- NEMT-Go 命名规范检查配置 -->
<rules>
    <package_naming>
        <pattern>[a-z][a-z0-9_]*</pattern>
        <description>包名必须使用小写字母，可包含数字和下划线</description>
    </package_naming>

    <file_naming>
        <pattern>[a-z][a-z0-9_]*\.go</pattern>
        <exceptions>
            <pattern>main\.go</pattern>
        </exceptions>
        <description>文件名必须使用小写下划线格式</description>
    </file_naming>

    <type_naming>
        <pattern>[A-Z][a-zA-Z0-9]*</pattern>
        <types>
            <type>struct</type>
            <type>interface</type>
            <type>class</type>
            <type>enum</type>
        </types>
        <description>类型名必须使用 PascalCase</description>
    </type_naming>

    <function_naming>
        <pattern>[A-Z][a-zA-Z0-9]*</pattern>
        <exported>true</exported>
        <description>导出的函数必须使用 PascalCase</description>
    </function_naming>

    <function_naming>
        <pattern>[a-z][a-zA-Z0-9]*</pattern>
        <exported>false</exported>
        <description>未导出的函数使用 camelCase</description>
    </function_naming>

    <variable_naming>
        <pattern>[a-z][a-zA-Z0-9]*</pattern>
        <description>变量名必须使用 camelCase</description>
    </variable_naming>

    <constant_naming>
        <pattern>[A-Z][A-Z0-9_]*</pattern>
        <description>常量必须使用全大写，可用下划线分隔</description>
    </constant_naming>
</rules>
