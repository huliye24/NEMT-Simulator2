{
  "nodes": {
    "market_node": {
      "enabled": true,
      "class": "capsules.MarketNode",
      "config": {
        "max_latency_ms": 1000,
        "max_cache_size": 1000
      }
    },
    "signal_node": {
      "enabled": true,
      "class": "capsules.SignalNode",
      "config": {
        "min_confidence": 0.6,
        "max_signals_per_symbol": 5
      }
    },
    "risk_node": {
      "enabled": true,
      "class": "capsules.RiskNode",
      "config": {
        "max_position_size": 0.1,
        "daily_loss_limit": 0.03
      }
    },
    "brain_node": {
      "enabled": true,
      "class": "capsules.BrainNode",
      "config": {
        "min_confidence_threshold": 0.65,
        "max_risk_score": 0.5
      }
    },
    "execution_node": {
      "enabled": true,
      "class": "capsules.ExecutionNode",
      "config": {
        "initial_balance": 100000,
        "order_fee_rate": 0.001
      }
    }
  },
  "pipeline": [
    ["market_node", "signal_node"],
    ["signal_node", "risk_node"],
    ["risk_node", "brain_node"],
    ["brain_node", "execution_node"]
  ],
  "monitoring": {
    "enabled": true,
    "port": 9090,
    "metrics_interval": 60
  }
}
